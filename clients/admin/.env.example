# Copy to .env and fill in. Only VITE_-prefixed vars reach the client bundle.

# Backend API base URL (the Express gateway).
VITE_API_URL="http://localhost:3000"

# Supabase project — Project Settings -> API. The anon/publishable key is
# meant to be public (RLS + backend JWT verification enforce access).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
