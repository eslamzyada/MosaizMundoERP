  stocktakes          stocktakes          @relation(fields: [stocktake_id, organization_id], references: [id, organization_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([stocktake_id, raw_item_id])
  @@index([stocktake_id], map: "stocktake_items_stocktake_idx")
}

