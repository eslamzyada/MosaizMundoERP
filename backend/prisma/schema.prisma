  missing_quantity    Decimal             @db.Decimal(10, 3)
  recorded_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  raw_inventory_items raw_inventory_items @relation(fields: [raw_item_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organization_id, raw_item_id], map: "inventory_deficits_org_item_idx")
