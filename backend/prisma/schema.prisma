  counted_quantity    Decimal             @default(0) @db.Decimal(10, 3)
  variance            Decimal?            @default(dbgenerated("(counted_quantity - expected_quantity)")) @db.Decimal(10, 3)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
