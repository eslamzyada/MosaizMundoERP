  suppliers              suppliers?              @relation(fields: [supplier_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_batches_supplier_fkey")
  inventory_consumption  inventory_consumption[]
  stock_write_off_lines  stock_write_off_lines[]

