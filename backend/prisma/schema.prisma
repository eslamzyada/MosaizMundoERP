model bill_of_materials {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String              @db.Uuid
  sellable_item_id    String              @db.Uuid
  raw_item_id         String              @db.Uuid
  quantity_required   Decimal             @db.Decimal(10, 3)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  raw_inventory_items raw_inventory_items @relation(fields: [raw_item_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  sellable_items      sellable_items      @relation(fields: [sellable_item_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, sellable_item_id, raw_item_id])
  @@index([sellable_item_id], map: "bill_of_materials_sellable_idx")
}

